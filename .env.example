# ============================================================================
# MSOT Club Activities Tracker — Supabase & Backend Configuration
# Copy this file to `.env` and fill in your Supabase project details.
# When SUPABASE_DB_URL is left empty, the app automatically runs on the
# local Supabase-compatible SQLite WAL engine with all sample data seeded.
# ============================================================================

# 1. Supabase PostgreSQL Connection String (from Supabase Dashboard -> Connect -> Transaction/Session Pooler)
# Example: postgresql://postgres.abcdefghijklm:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# 2. Supabase Project API URL & Keys (for Supabase Storage uploads of PPTs, Certificates & Event Gallery)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=club-tracker-assets

# 3. Cryptographic Signing Secret for Tamper-Proof PDF Certificates & Transcripts
MSOT_CERT_SECRET=msot-verified-cocurricular-ledger-secret-2026

