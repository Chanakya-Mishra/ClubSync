# ============================================================================
# ClubSync — Environment Configuration Template
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your actual `.env` file containing secrets to version control.
# ============================================================================

# 1. Supabase PostgreSQL Connection String (Transaction / Session Pooler)
# When empty, ClubSync runs on the local SQLite engine with sample data seeded.
# Example: postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=

# 2. Supabase Project API URL & Service Keys (for cloud storage of uploads/certificates)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=club-tracker-assets

# 3. Cryptographic Signing Secret for Tamper-Proof PDF Certificates & Transcripts
MSOT_CERT_SECRET=your-random-cryptographic-secret-here

# 4. Google App Password & Email Notifications (Club Meetings, Announcements, Password Resets)
# How to obtain a Google App Password:
# 1. Go to your Google Account (myaccount.google.com) -> Security.
# 2. Ensure 2-Step Verification is turned ON.
# 3. Search for "App Passwords" or navigate to: https://myaccount.google.com/apppasswords
# 4. Generate an App Password for "ClubSync" (16-letter code).
# 5. Paste the email address and 16-character password below:
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_SENDER_NAME="ClubSync Multi-Campus Platform"
